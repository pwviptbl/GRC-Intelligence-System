APP_NAME="GRC Intelligence System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost
APP_PORT=8088
COMPANY_NAME="Empresa"

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
FORWARD_DB_PORT=5433
DB_DATABASE=grc_db
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6380

GEMINI_API_KEY=

# =============================================================================
# MCP — Configuração de Autenticação
# =============================================================================
#
# MCP_AUTH_MODE=oauth   → Recomendado para produção (OAuth 2.1 via Auth0)
# MCP_AUTH_MODE=bearer  → Token Bearer estático (legado, local/dev)
#
MCP_AUTH_MODE=bearer

# --- Modo Bearer (legado / desenvolvimento local) -------------------------
# Token estático. Em produção com OAuth, mantenha vazio ou defina
# MCP_LEGACY_BEARER_ENABLED=false para desabilitar o fallback.
MCP_SERVER_TOKEN=
# Opcional durante rotação: aceite token atual e novo, separados por vírgula.
MCP_SERVER_TOKENS=
MCP_LEGACY_BEARER_ENABLED=false

# --- Modo OAuth 2.1 (Auth0 recomendado) ------------------------------------
#
# Passos no Auth0:
#   1. Crie uma API em Applications > APIs:
#      Identifier: https://grc-mcp
#      Signing Algorithm: RS256
#   2. Adicione permissões (scopes): grc:read  e  grc:write
#   3. Crie uma Application (Machine-to-Machine ou Regular Web App):
#      - Para ChatGPT Developer Mode: Regular Web App
#      - Authorize a API "grc-mcp" com os scopes grc:read e grc:write
#      - Callback URL: https://chatgpt.com/connector/oauth/{callback_id}
#        (o callback_id é exibido pelo ChatGPT ao configurar o plugin)
#   4. Preencha as variáveis abaixo com os valores do seu tenant Auth0.
#
# Configuração no ChatGPT Developer Mode:
#   - Tipo: OAuth
#   - Client ID: (Client ID da aplicação no Auth0)
#   - Client Secret: (Client Secret da aplicação no Auth0)
#   - Authorization URL: https://SEU_TENANT.auth0.com/authorize
#   - Token URL: https://SEU_TENANT.auth0.com/oauth/token
#   - Scope: grc:read grc:write
#   - Callback URL: https://chatgpt.com/connector/oauth/{callback_id}
#
MCP_OAUTH_ISSUER=https://SEU_TENANT.auth0.com/
MCP_OAUTH_AUDIENCE=https://grc-mcp
MCP_OAUTH_JWKS_URI=
# Deixe em branco para derivar automaticamente: {issuer}.well-known/jwks.json
MCP_OAUTH_REQUIRED_SCOPES_READ=grc:read
MCP_OAUTH_REQUIRED_SCOPES_WRITE=grc:write
# URL pública HTTPS do endpoint /mcp (ex: URL do ngrok em desenvolvimento)
MCP_OAUTH_RESOURCE_URL=https://SEU-DOMINIO.ngrok.app/mcp
MCP_OAUTH_LEEWAY_SECONDS=30
MCP_OAUTH_JWKS_CACHE_TTL=600

# --- Configurações gerais do MCP -------------------------------------------
# NUNCA defina como true em produção com endpoint público.
MCP_ALLOW_UNAUTHENTICATED=false
MCP_ALLOWED_ORIGINS=https://chatgpt.com
MCP_RATE_LIMIT_PER_MINUTE=120
MCP_WRITE_RATE_LIMIT_PER_MINUTE=30

# =============================================================================
# Backups
# =============================================================================
BACKUP_RETENTION=8
